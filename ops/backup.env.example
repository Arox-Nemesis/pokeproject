# =============================================================================
# TELEMON BACKUP CONFIGURATION
# =============================================================================
# Copy to ops/backup.env and fill in. This file is gitignored.
#
#   cp ops/backup.env.example ops/backup.env
#
# NOTE: this file does NOT contain cloud credentials. Those live in
# ops/rclone.conf so that the credential surface stays in exactly one place.

# -----------------------------------------------------------------------------
# TIER 3 — APPEND-ONLY ARCHIVE (this is your actual backup)
# -----------------------------------------------------------------------------
# Space-separated rclone remotes. Every artifact is pushed to ALL of them.
# Two providers = the "2" in the 3-2-1 rule. Both have a free tier that
# comfortably fits this workload.
#
# Recommended: Backblaze B2 as primary (it supports Object Lock / WORM and
# application keys that can write but NOT delete), Cloudflare R2 as secondary
# (zero egress, so restore drills are free).
#
# For an ENCRYPTED archive, point these at rclone `crypt` remotes instead:
#   BACKUP_REMOTES="b2crypt: r2crypt:"
# See ops/rclone.conf.example and ops/encrypt_setup.sh.
BACKUP_REMOTES="b2:telemon-archive r2:telemon-archive"

# WHERE RESTORES READ FROM. Writes go to every remote above; reads come from
# here. This is not a micro-optimisation — it is a correctness requirement:
#
# B2's free tier caps DOWNLOADS at 1 GB/day. A single restore drill of this
# database pulls ~1.2 GB, so the second one hits the cap. Worse, B2 reports the
# cap as "object not found", so rclone exits 0 having downloaded NOTHING — a
# silent failure in exactly the tool you use during an emergency.
#
# Cloudflare R2 has zero egress fees and no download cap, so drills and
# restores are free and unlimited there. Keep B2 as the WORM/Object-Lock
# write target; restore from R2.
#
# Leave empty to fall back to the first entry in BACKUP_REMOTES.
RESTORE_REMOTE="r2:telemon-archive"

# Static assets (data/official-artwork ~342MB, data/csv ~36MB, data/*.json).
# SEPARATE remotes with separate credentials: a B2 application key scoped to
# telemon-archive cannot read or write telemon-assets, so these cannot be
# derived from BACKUP_REMOTES.
#
# Note `b2assets:` — a second B2 key scoped to the assets bucket. R2 tokens can
# cover multiple buckets, so `r2:` is reused.
#
# Used by ops/sync_assets.sh and ops/bootstrap.sh. Leave empty to skip assets
# entirely (they are regenerable via scripts/fetch_*.py, just slowly).
ASSET_REMOTES="b2assets:telemon-assets r2:telemon-assets"

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
PG_CONTAINER=telemon_postgres
PG_USER=telemon
PG_DB=telemon
BOT_CONTAINER=telemon_bot

# -----------------------------------------------------------------------------
# Local state (last-known-good counts, locks, drill results)
# -----------------------------------------------------------------------------
STATE_DIR=/var/lib/telemon-backup

# -----------------------------------------------------------------------------
# Alerting — reuse your bot token, or better, make a second "ops" bot so a
# leaked backup config can't post as the game bot.
# -----------------------------------------------------------------------------
BOT_TOKEN=
ALERT_CHAT_ID=

# -----------------------------------------------------------------------------
# Anomaly gate thresholds
# -----------------------------------------------------------------------------
# A guarded table shrinking by more than this fraction quarantines the dump
# and halts retention pruning. 0.10 = 10%.
ANOMALY_SHRINK_THRESHOLD=0.10
# Absolute row drop that trips the gate regardless of percentage. Catches
# "table went from 40 rows to 5" on small tables where 10% is noise.
ANOMALY_ABSOLUTE_DROP=25
# Any guarded table hitting exactly zero always trips the gate.

# -----------------------------------------------------------------------------
# Uploader tuning (read by the wal-uploader container)
# -----------------------------------------------------------------------------
UPLOAD_INTERVAL_SECONDS=15
# Warn when the local WAL spool exceeds this. 1 GiB default.
SPOOL_WARN_BYTES=1073741824
# Uploaded segments are kept locally for this long instead of being deleted.
# Two things depend on it:
#   * the delayed standby replays from here (so it needs no cloud access and
#     creates no replication slot on the primary)
#   * a local PITR skips the download entirely — a big RTO win
# Must comfortably exceed STANDBY_DELAY.
LOCAL_WAL_RETAIN_HOURS=30

# -----------------------------------------------------------------------------
# TIME-DELAYED STANDBY (the "undo button with a fuse")
# -----------------------------------------------------------------------------
# A live Postgres that deliberately stays this far behind the primary. It
# receives a 07:31 wipe immediately but refuses to apply it until 08:31,
# giving you a queryable pre-incident database and an hour to freeze it.
#
# Start with: ops/standby_start.sh    Freeze with: ops/standby_freeze.sh
STANDBY_DELAY=1h
STANDBY_PORT=5495
STANDBY_CONTAINER=telemon_standby
STANDBY_DATA_DIR=/var/lib/telemon-standby

# -----------------------------------------------------------------------------
# TIER 2 — WARM MIRROR (optional; failover and server migration only)
# -----------------------------------------------------------------------------
# ⚠ THE MIRROR IS NOT A BACKUP. It replicates deletes in milliseconds.
#   It protects against hardware loss, not against mistakes, bugs or attackers.
#   The archive above is what protects you from those.
#
# Leave MIRROR_URL empty to run without a mirror (everything else still works).
#
# MIRROR_URL — how YOU reach the mirror (libpq URI). Works with Neon's free
#              tier, or any Postgres 16+.
MIRROR_URL=
# MIRROR_PRIMARY_CONNINFO — how the MIRROR dials back to THIS primary. Must be
#              reachable from the mirror's network: a public host:port, never
#              "localhost" or a docker-internal name.
MIRROR_PRIMARY_CONNINFO=
MIRROR_PUBLICATION=telemon_pub
MIRROR_SUBSCRIPTION=telemon_sub
# Shout if a replication slot retains more than this much WAL on the primary.
# An inactive slot retaining WAL forever will fill your disk and take the bot
# down — the mirror killing the primary is the worst failure mode here.
MIRROR_SLOT_WARN_BYTES=4294967296

# Docker network used when a temporary client container is needed (promotion
# while the primary is down).
DOCKER_NETWORK=telemon_default

# -----------------------------------------------------------------------------
# Retention (prefer bucket lifecycle rules — see ops/prune.sh)
# -----------------------------------------------------------------------------
# SIZED FOR A ~600 MB DATABASE AND A 10 GB FREE TIER. Steady-state footprint:
#
#   WAL    14d x 244 MB/day              = 3.4 GB   ← the RPO-critical tier
#   base   14d x 188 MB                  = 2.6 GB   ← the PITR anchor
#   user    7d x 4/day x 68 MB           = 1.9 GB
#   full   14d x 1/day x 128 MB          = 1.8 GB
#                                   TOTAL ≈ 9.7 GB
#
# RETAIN_BASE_DAYS must be >= RETAIN_WAL_DAYS. To recover to a point 14 days
# ago you need a base backup at least that old to replay forward from; pruning
# base faster than WAL silently shortens your real recovery window.
#
# If your database grows, do not shrink WAL or base first — buy storage. B2 is
# ~$6/TB/month, so 25 GB costs about $0.15/month. Paying pennies is a better
# trade than narrowing the recovery window on a live game.
RETAIN_WAL_DAYS=10
RETAIN_USER_DAYS=7
RETAIN_FULL_DAYS=10
RETAIN_BASE_DAYS=10
